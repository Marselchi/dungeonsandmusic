# Optional default backend URL baked in at build time (e.g. for a fixed
# LAN address). Most deployments should leave this unset and let each
# visitor set their backend URL at runtime instead — see UI_GUIDE.md's
# "Deployment model" section for why. Must be NEXT_PUBLIC_-prefixed to be
# available in the browser bundle at all (this is a static export; there
# is no server to hide it behind).
NEXT_PUBLIC_BACKEND_URL=http://localhost:21000
